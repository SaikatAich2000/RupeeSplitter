<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer only the theme preference. Listing an include excludes everything else. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="rupee_splitter_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="rupee_splitter_settings.xml" />
    </device-transfer>
</data-extraction-rules>
