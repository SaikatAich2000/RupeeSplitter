<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer policy: exclude all app data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
