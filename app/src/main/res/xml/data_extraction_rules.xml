<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only the small theme-preference file. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="rupee_splitter_settings.xml" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
